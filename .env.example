# cp .env.example .env
# --- Neo4j Database (Local Docker hoặc Neo4j AuraDB) ---
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# --- Extraction & Generation LLM (Groq) ---
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
# Sample nằm trong scale guard 400 chunks; cấu hình này giảm usage cho Free Tier.
LAB_EXTRACTION_CHUNKS=200
LAB_COREF_BATCH_SIZE=8
LAB_EXTRACTION_BATCH_SIZE=8

# --- LLM-as-a-Judge (OpenAI, Groq hoặc Gemini) ---
JUDGE_PROVIDER=groq
JUDGE_MODEL=openai/gpt-oss-120b
# Không cần hai key dưới đây khi JUDGE_PROVIDER=groq.
OPENAI_API_KEY=sk-...
# Gemini thay OpenAI: JUDGE_PROVIDER=gemini, JUDGE_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your-gemini-api-key

# --- Hugging Face Access Token (để stream dataset HackerNoon) ---
HF_TOKEN=hf_...
